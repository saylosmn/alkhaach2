# --- MongoDB Atlas ---
MONGO_URL=mongodb+srv://ХЭРЭГЛЭГЧ:НУУЦҮГ@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=alkhaach

# --- Google OAuth (Google Cloud Console → Credentials → OAuth client ID → Web application) ---
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# --- Энэ backend-ийн нийтийн хаяг (сүүлийн / байхгүй) ---
PUBLIC_BASE_URL=https://alkhaach2.onrender.com

# --- Апп руу буцаах зөвшөөрөгдсөн redirect-үүд (заавал биш) ---
# Default: alkhaach://,exp://,http://localhost,http://127.0.0.1
# ALLOWED_REDIRECT_PREFIXES=alkhaach://,exp://

# --- Мэдэгдэл (заавал биш) ---
# SCHEDULER_IN_PROCESS=0 бол аппын доторх давталт унтарна — гадны cron
# POST /api/internal/notify-tick (X-Notify-Secret толгойтой) дуудна.
# SCHEDULER_IN_PROCESS=1
# NOTIFY_SECRET=санамсаргүй-урт-мөр

# --- Тест (backend/tests) ---
# TEST_BASE_URL=http://localhost:8000
